# ──────────────────────────────────────────────────────────────
# Репетитор из Коми · фронтенд (Vite) · переменные окружения
# Скопируйте файл в .env и заполните:   cp .env.example .env
# Все переменные фронтенда начинаются с VITE_ — иначе Vite их не отдаст.
# ──────────────────────────────────────────────────────────────

# Адрес бэкенда. Локально с запущенным docker compose: http://localhost:8000.
# Если бэкенд не отвечает, фронтенд сам уйдёт в демо-режим (localStorage).
VITE_API_URL=http://localhost:8000

# Дата ЕГЭ (формат ISO). Отображается в счётчике «дней до ЕГЭ».
VITE_EGE_DATE=2027-06-07

# Средний балл по РФ (ориентир на графике аналитики).
VITE_RU_AVG_SCORE=64

# Ссылка на группу ВК (виджет «Написать в VK»).
VITE_VK_GROUP_URL=https://vk.com/repetitor_iz_komi

# Фото преподавателя (прямая ссылка на изображение).
# VITE_TUTOR_PHOTO_URL=

# Зеркало мастер-аккаунта преподавателя для автономного режима.
VITE_ADMIN_NICKNAME=daniil
VITE_ADMIN_PASSWORD=Pudov-Ege-2026
# Код привязки учеников (отсылка к реке Сысоле, без фамилии).
VITE_ADMIN_TEACHER_CODE=SYSOLA-PRO
