# Репетитор из Коми · переменные окружения фронтенда (Vite)
# Скопируйте в .env и заполните:  cp .env.example .env

# Базовый URL бэкенда. Пустая строка = автономный режим на localStorage.
VITE_API_URL=http://localhost:8000

# Дата ЕГЭ (виджет обратного отсчёта). Формат: ГГГГ-ММ-ДД.
VITE_EGE_DATE="2026-06-07"

# Ссылка на группу ВК (кнопка «Написать в VK»).
VITE_VK_GROUP_URL="https://vk.com/repetitor_iz_komi"

# Фото преподавателя (виджет ВК). При ошибке загрузки — аватар-заглушка.
VITE_TUTOR_PHOTO_URL=""

# Мастер-аккаунт преподавателя для АВТОНОМНОГО режима (локальный предпросмотр).
# В продакшене преподавателя создаёт backend/scripts/create_admin.py из серверного .env.
VITE_ADMIN_NICKNAME="artem"
VITE_ADMIN_PASSWORD="artem-2026"
VITE_ADMIN_TEACHER_CODE="ARTEM-PRO"
