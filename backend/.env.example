# Репетитор из Коми · переменные окружения бэкенда
# Скопируйте в .env и заполните реальными значениями:  cp .env.example .env

# ── База данных ─────────────────────────────────────────────────────
# Строка подключения к PostgreSQL (async-драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://komi:komi_secret@localhost:5432/repetytor

# ── Секреты ─────────────────────────────────────────────────────────
# Секрет подписи HMAC-токенов авторизации. Обязательно смените!
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
HMAC_SECRET=dev-secret-change-me

# Обратная совместимость: если задан SECRET_KEY, а HMAC_SECRET — нет,
# будет использован SECRET_KEY (устаревшее имя).
# SECRET_KEY=

# ── Сеть ────────────────────────────────────────────────────────────
# Разрешённые источники CORS (домены фронтенда через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Публичный базовый URL сайта — из него формируются короткие ссылки
# на варианты (https://ваш-домен.ru/?variant=VAR-XXXXXXXX)
PUBLIC_BASE_URL=http://localhost:5173

# (Опционально) URL фронтенда для ссылок в письмах (сброс пароля)
FRONTEND_URL=http://localhost:5173
