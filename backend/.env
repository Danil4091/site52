# ──────────────────────────────────────────────────────────────
# Репетитор из Коми · бэкенд · переменные окружения
# Файл .env в git НЕ попадает (он в .gitignore) — секреты в безопасности.
# ──────────────────────────────────────────────────────────────

# PostgreSQL (async-драйвер asyncpg).
# В docker-compose адрес подставляется автоматически (контейнер db).
DATABASE_URL=postgresql+asyncpg://komi:komi_secret@db:5432/repetytor

# Секрет для подписи HMAC-токенов. ОБЯЗАТЕЛЬНО смените в продакшене!
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(48))"
HMAC_SECRET=dev-secret-change-me

# Разрешённые источники для CORS (через запятую).
# Локально: localhost на портах 3000 и 5173. Для продакшена укажите реальный домен.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Публичный адрес сайта — для генерации ссылок на варианты (?variant=VAR-…).
PUBLIC_BASE_URL=http://localhost:5173

# ── Мастер-аккаунт преподавателя (создаётся автоматически при старте) ──
ADMIN_USERNAME=daniil
ADMIN_PASSWORD=Pudov-Ege-2026
# Код привязки учеников (отсылка к реке Сысоле, без фамилии).
ADMIN_TEACHER_CODE=SYSOLA-PRO
ADMIN_FULL_NAME=Даниил Андреевич Пудов

# Автоматически создать таблицы при старте (true для разработки).
CREATE_TABLES=true
